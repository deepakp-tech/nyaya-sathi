# =====================================================================
# Copy this file to `.env` and fill in the values marked  <-- ADD
# You need ONE LLM key. Everything else is optional.
# =====================================================================

# ---------- 1. LLM (required: pick ONE provider) ----------
# Options: groq | google_genai | anthropic | openai
LLM_PROVIDER=groq
# Model IDs change often — copy the exact ID from your provider's console.
# Examples: groq -> openai/gpt-oss-120b | google_genai -> gemini-flash-latest
#           anthropic -> claude-sonnet-4-5 | openai -> gpt-4o-mini
LLM_MODEL=openai/gpt-oss-120b
# Optional smaller/cheaper model for triage & checks (defaults to LLM_MODEL)
LLM_FAST_MODEL=openai/gpt-oss-20b

GROQ_API_KEY=            # <-- ADD if LLM_PROVIDER=groq   (console.groq.com, free)
GOOGLE_API_KEY=          # <-- ADD if LLM_PROVIDER=google_genai (aistudio.google.com, free tier)
ANTHROPIC_API_KEY=       # <-- ADD if LLM_PROVIDER=anthropic
OPENAI_API_KEY=          # <-- ADD if LLM_PROVIDER=openai

# ---------- 2. Observability: LangSmith (optional, free Developer plan) ----------
LANGSMITH_TRACING=false          # set true once you add the key
LANGSMITH_API_KEY=               # <-- ADD (smith.langchain.com)
LANGSMITH_PROJECT=ai-lawyer-india

# ---------- 3. Voice: Sarvam AI (optional) ----------
SARVAM_API_KEY=                  # <-- ADD to enable voice input/output (dashboard.sarvam.ai)
SARVAM_STT_MODEL=saarika:v2.5    # check docs.sarvam.ai for current model IDs
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya    

# ---------- 4. Retrieval ----------
# Small multilingual model, runs on CPU, free. Swap for BAAI/bge-m3 if you have RAM.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHROMA_DIR=.chroma
RETRIEVAL_K=6

# ---------- 5. Guardrails ----------
ENABLE_GROUNDING_CHECK=true      # extra LLM call that checks claims vs sources
MAX_REGENERATIONS=2

# ---------- 6. Advanced ----------
# Groq gpt-oss needs json_schema (+ STRUCTURED_STRICT=true). For other providers leave both empty unless structured output fails: function_calling | json_schema | json_mode
STRUCTURED_METHOD=json_schema
# true = provider-enforced schema (supported by Groq gpt-oss with json_schema). Leave empty otherwise.
STRUCTURED_STRICT=true

# ---------- 7. Conversation storage ----------
# SQLite file for chat history + LangGraph checkpoints: <DATA_DIR>/nyaya.db (drafts in <DATA_DIR>/drafts/<conversation>)
DATA_DIR=data
# false = keep conversations in memory only (lost on restart)
PERSIST_CONVERSATIONS=true
